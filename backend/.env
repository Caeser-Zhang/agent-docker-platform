# Backend environment configuration — loaded via docker-compose env_file.
# Edit this file, then `docker compose up -d` to apply (no rebuild needed).
# P1-5: the signing key must be a strong random value (>=32 chars; the app
# refuses to boot on the old demo defaults). It signs JWTs and derives the
# Fernet keys that encrypt container passwords / API keys. Rotate with care:
# rotating invalidates every stored encrypted value.
AGENT_SECRET_KEY=ZEZH76L-CMqg7aFL4WieNTq7hSQNJ59auJKULNqeQC9KEpJ_QmFTYF5rxTQvyVqB
# Usernames granted the admin role (Docker management panel).
# The first user to register on a fresh database is also admin.
AGENT_ADMIN_USERNAMES=admin
# PostgreSQL service defined in docker-compose.yml (same stack network).
# Switch back to SQLite with:
#   AGENT_DATABASE_URL=sqlite+aiosqlite:////app/data/agent_demo.db
AGENT_DATABASE_URL=postgresql+asyncpg://agent:agentpass@postgres:5432/agent_demo
AGENT_AGENT_IMAGE=agent-demo:1.4.0
AGENT_AGENT_NETWORK=agent-net
AGENT_AGENT_PORT=4096
AGENT_AGENT_WORKDIR=/workspace
# SearXNG instance backing the built-in web_search MCP tool (docker-compose
# defines the `searxng` service on agent-net; point this at another instance
# if you run your own).
AGENT_SEARXNG_URL=http://searxng:8080
# DEPRECATED (P0④): fastk-mcp retired — manifest deleted, compose service removed.
# Kept for reference; no longer consumed by any code path.
# AGENT_FASTK_MCP_URL=http://fastk-mcp:8001/mcp
# fastk REST server (fastdb serve fastapi on the WSL host), reached via
# host-gateway. BACKEND ONLY: routers/kb_proxy.py forwards here after injecting
# the per-database key, and routers/fastk.py resolves citation badges through
# it. Agent containers must never see this address — they get
# AGENT_KB_PROXY_BASE below instead.
AGENT_FASTK_SERVER_URL=http://host.docker.internal:8000
# Base URL injected into every user container as FASTDB_BASE_URL, so the
# built-in fastk CLI can only reach the knowledge bases through the whitelist
# proxy (routers/kb_proxy.py). "backend" resolves on agent-net.
AGENT_KB_PROXY_BASE=http://backend:8000
# 白名单拒绝（403）文案里的管理员联系人，多个用 、 或 , 分隔。
# 改这里只需重启 backend，用户容器不受影响。
AGENT_KB_ADMIN_CONTACT=张智骁（工号 00899219）
AGENT_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Where the backend finds the developer's opencode.json (mounted in compose)
AGENT_OPENCODE_CONFIG_SOURCE=/host-opencode/opencode.json
AGENT_CONTAINER_HOST_ALIAS=host.docker.internal
# PPTX 模板库：library/pptx-templates/samples/ 里是开发期样例（第三方素材，无再分发
# 授权），默认不入库、也不对普通用户可见。本机验证期间打开下面这行，让 docs/ 那两份
# 真实模板入库可见；**生产环境请改回注释状态**，改完 `docker compose up -d backend`
# （或管理员页「重跑种子」并勾选样例）。
# AGENT_PPTX_LIBRARY_ALLOW_SAMPLES=true
