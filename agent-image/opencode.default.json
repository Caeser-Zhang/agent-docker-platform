{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "webfetch": "allow",
    "todowrite": "allow",
    "external_directory": "allow",
    "skill": "allow",
    "web_search*": "allow",
    "present_file": "allow"
  },
  "mcp": {
    "web_search": {
      "type": "local",
      "command": ["python3", "/opt/agent/builtin-mcp/web_search/web_search_mcp.py"],
      "environment": {
        "SEARXNG_URL": "http://searxng:8080"
      },
      "enabled": true
    }
  },
  "plugin": [
    "/opt/agent/builtin-plugins/oh-my-opencode-slim/node_modules/oh-my-opencode-slim"
  ],
  "provider": {}
}
