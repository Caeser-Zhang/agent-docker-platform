# Copy to .env before `docker compose up -d`.
#
# Absolute path (on the Docker host) to the opencode config directory.
# The backend mounts this directory read-write so it can manage
# opencode.json AND skill files via the config API.
#
# WSL2 + config living on the Windows side:
#   OPENCODE_CONFIG_DIR=/mnt/c/Users/<you>/.config/opencode
# Native Linux / config inside WSL:
#   OPENCODE_CONFIG_DIR=/home/<you>/.config/opencode
# macOS:
#   OPENCODE_CONFIG_DIR=/Users/<you>/.config/opencode
#
# Leave unset to fall back to ~/.config/opencode (no providers,
# so prompts will fail until you point this at a real config).
OPENCODE_CONFIG_DIR=/mnt/c/Users/zhangzhixiao/.config/opencode
