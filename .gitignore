# Environment & secrets
# NOTE: backend/.env is committed with generated demo values. P1-5 added a
# boot-time guard in config.py that refuses known-weak/short AGENT_SECRET_KEY
# values; a real deployment must override the key locally and should then
# remove the !backend/.env exception below.
.env
!backend/.env
*.env.local

# Real opencode config contains gateway URL + apiKey — commit only the
# .example template. Copy it to config/opencode.json and fill in secrets.
config/opencode.json

# WSL host setup helpers. config.yaml is a copy of ~/.fastk/config.yaml and
# carries a real embedding-provider apiKey — never commit.
.wsl-setup/config.yaml

# Database
*.db
*.db-journal
backend/agent_demo.db

# Build artifacts
frontend/dist/
frontend/node_modules/
backend/__pycache__/
**/__pycache__/
*.pyc

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Docker
docker-compose.override.yml

# Logs
*.log

# Local test scratch area (mounted test config/workspace, diagnostic scripts).
# Contains a copy of config/opencode.json with a real apiKey — never commit.
.tmp/
