# Environment & secrets
# NOTE: backend/.env is intentionally committed (demo defaults, no real
# secrets). Override values locally; do not commit real credentials.
.env
!backend/.env
*.env.local

# Real opencode config contains gateway URL + apiKey — commit only the
# .example template. Copy it to config/opencode.json and fill in secrets.
config/opencode.json

# Database
*.db
*.db-journal
backend/agent_demo.db

# Build artifacts
frontend/dist/
frontend/node_modules/
backend/__pycache__/
**/__pycache__/
*.pyc

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Docker
docker-compose.override.yml

# Logs
*.log
